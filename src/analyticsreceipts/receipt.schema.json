{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyticsreceipts/receipt.schema.json",
  "title": "analyticsreceipts receipt",
  "description": "One receipt per executed query. Version 2 adds a required `compiler` and ties it to `kind`; version 1 is the recorded legacy shape (compiler optional).",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "kind", "request", "metric_id", "metric_def_version", "semantic_model_sha256",
               "compiled_sql", "params", "compiled_sql_sha256", "engine", "snapshot", "result", "result_sha256",
               "row_count", "truncated", "error", "checks", "uncertainty", "run"],
  "properties": {
    "receipt_version": {"enum": ["1", "2"]},
    "kind": {"enum": ["governed_metric", "control_metric", "raw_sql"],
             "description": "governed_metric: the governed compiler ran. control_metric: a planted (deliberately broken) compiler ran. raw_sql: the harness's raw SQL tool ran."},
    "compiler": {"type": ["string", "null"], "description": "\"governed\", \"planted:<bug>\", or null for raw SQL"},
    "request": {"type": "object", "description": "the canonical governed request, or {\"sql\": ...} for raw SQL"},
    "metric_id": {"type": ["string", "null"]},
    "metric_def_version": {"type": ["string", "null"]},
    "semantic_model_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}],
                              "description": "the pinned model hash for the governed compiler; a derived hash for any other compiler"},
    "compiled_sql": {"type": "string"},
    "params": {"type": "array"},
    "compiled_sql_sha256": {"$ref": "#/$defs/sha256"},
    "engine": {"type": "object", "required": ["name", "version"],
               "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "snapshot": {"type": ["object", "null"],
                 "additionalProperties": {"type": ["string", "null"]}},
    "result": {"type": "object", "required": ["columns", "rows"],
               "properties": {"columns": {"type": "array", "items": {"type": "string"}},
                              "rows": {"type": "array", "items": {"type": "array"}}}},
    "result_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}], "description": "null when the query errored"},
    "row_count": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {
      "type": "object", "required": ["name", "success", "expected"], "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "success": {"type": "boolean"}, "expected": {"type": "string"},
                     "actual": {}, "note": {"type": ["string", "null"]}}}},
    "uncertainty": {"type": "object", "required": ["caveats_applied"],
                    "properties": {"caveats_applied": {"type": "array", "items": {"type": "string"}}}},
    "run": {"type": "object", "required": ["request_id", "server_version", "started_at", "elapsed_s"],
            "properties": {"request_id": {"type": "string"}, "server_version": {"type": "string"},
                           "started_at": {"type": "string"}, "elapsed_s": {"type": "number"}}}
  },
  "allOf": [
    {"if": {"properties": {"receipt_version": {"const": "2"}}},
     "then": {"required": ["compiler"]}},
    {"if": {"properties": {"kind": {"const": "governed_metric"}}, "required": ["compiler"]},
     "then": {"properties": {"compiler": {"enum": ["governed", null]}}}},
    {"if": {"properties": {"kind": {"const": "control_metric"}}},
     "then": {"required": ["compiler"], "properties": {"compiler": {"type": "string", "not": {"const": "governed"}}}}},
    {"if": {"properties": {"kind": {"const": "raw_sql"}}, "required": ["compiler"]},
     "then": {"properties": {"compiler": {"type": "null"}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
